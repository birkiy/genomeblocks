{
  "name": "genomeblocks-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Genomeblocks unified platform: static docs + interactive dashboard on one domain, Node orchestrator, Python compute sidecar.",
  "scripts": {
    "dev": "pnpm -r --parallel --filter=./apps/* run dev",
    "dev:web": "pnpm --filter web run dev",
    "dev:orchestrator": "pnpm --filter orchestrator run dev",
    "build": "pnpm -r --filter=./apps/* run build",
    "lint": "pnpm -r --filter=./apps/* run lint",
    "typecheck": "pnpm -r --filter=./apps/* run typecheck"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  }
}
