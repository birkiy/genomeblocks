{
 "meta": {
  "confirmed": "2026-10-23",
  "how": "Ten core and ten auxiliary jobs per theme, chosen from what the field's main tools are built around, before looking at genomeblocks; confirmed theme by theme by the author (Intervals with getfasta promoted to core and out-of-core streaming moved to auxiliary).",
  "fields": {
   "id": "C1-C10 core (the main, hardest or longest-running jobs), A1-A10 auxiliary",
   "standard": "the tools that define the job in the field",
   "checklist": "the tools.json capability keys that cover the job (62 of them added and filled by resurvey_jobs.py on 2026-10-23)",
   "tasks": "the benchmark tasks (results/landscape.json and the main suite) that time the job; empty = not timed",
   "genomeblocks": "yes / partial / no, read from the genomeblocks source on 2026-10-23, not from its inventory record"
  }
 },
 "themes": {
  "intervals": {
   "core": [
    {"id": "C1", "job": "Overlap join, all A x B pairs", "standard": "bedtools intersect -wa -wb", "checklist": ["overlap"], "tasks": ["overlap_pairs"], "genomeblocks": "yes"},
    {"id": "C2", "job": "Overlap filter / count (-u, -c, -v)", "standard": "bedtools intersect -u/-c/-v", "checklist": ["overlap"], "tasks": ["intersect", "overlap_count"], "genomeblocks": "yes", "note": "Loci.intersect / difference (intersect -u / -v), Loci.count_overlaps (-c, since 2026-10-24)"},
    {"id": "C3", "job": "Nearest / closest (ties, k nearest, strand)", "standard": "bedtools closest -k -s", "checklist": ["nearest"], "tasks": ["nearest"], "genomeblocks": "partial", "note": "single nearest only, no k"},
    {"id": "C4", "job": "Coverage of A over B (counts, bp, fraction)", "standard": "bedtools coverage", "checklist": ["coverage"], "tasks": ["coverage"], "genomeblocks": "yes", "note": "Loci.coverage: covered bases per row (since 2026-10-24)"},
    {"id": "C5", "job": "Genome-wide depth track", "standard": "bedtools genomecov -bg", "checklist": ["coverage"], "tasks": ["genome_depth"], "genomeblocks": "yes", "note": "genomeblocks.hichip.coverage takes any intervals"},
    {"id": "C6", "job": "Merge / cluster with distance and column aggregation", "standard": "bedtools merge -d -c -o, cluster", "checklist": ["merge"], "tasks": ["merge"], "genomeblocks": "partial", "note": "no -d distance, no column aggregation"},
    {"id": "C7", "job": "Subtract / difference", "standard": "bedtools subtract", "checklist": ["set_algebra"], "tasks": ["subtract"], "genomeblocks": "yes", "note": "Loci.subtract (base level, since 2026-10-24); Loci.difference is intersect -v"},
    {"id": "C8", "job": "Complement against a genome", "standard": "bedtools complement", "checklist": ["set_algebra"], "tasks": ["complement"], "genomeblocks": "yes", "note": "Loci.complement (since 2026-10-24)"},
    {"id": "C9", "job": "Parse + sort large BED / narrowPeak / GFF", "standard": "sort-bed, bedtools sort", "checklist": ["read_bed", "sort"], "tasks": ["read_bed"], "genomeblocks": "yes"},
    {"id": "C10", "job": "Sequence extraction, strand-aware", "standard": "bedtools getfasta", "checklist": ["getfasta"], "tasks": ["getfasta"], "genomeblocks": "yes"}
   ],
   "auxiliary": [
    {"id": "A1", "job": "Slop / flank / resize", "standard": "bedtools slop / flank", "checklist": ["slop"], "tasks": [], "genomeblocks": "partial", "note": "slop only"},
